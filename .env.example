# FilmGraph environment configuration.
# Copy to .env and fill in real values. Never commit .env.

# Neo4j connection (required to run an instance)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password_here

# TMDB API (required only to run seed/films/tmdb_fetch.py locally)
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_CACHE_PATH=./cache/tmdb

# Public API auth + rate limiting (optional)
FILMGRAPH_API_KEY=your_api_key_here

# Sync webhook protection (GitHub Action only)
FILMGRAPH_SYNC_KEY=your_sync_key_here

# Assemble showtimes MySQL read-only connection.
# Used ONLY by seed/venues/export.py to regenerate venues.jsonl.
# Not required to run a standard FilmGraph instance.
MYSQL_READ_URL=mysql+pymysql://user:password@host/database

# Node identity (docs/node-contract.md#node-manifest)
FILMGRAPH_NODE_ID=reference
FILMGRAPH_NODE_NAME=FilmGraph reference node
FILMGRAPH_NODE_OPERATOR_NAME=FilmGraph
FILMGRAPH_NODE_OPERATOR_URL=https://filmgraph.org
FILMGRAPH_NODE_LAYER=1
# none | optional | required
FILMGRAPH_NODE_AUTH=optional
# FILMGRAPH_NODE_MCP_URL=https://your-node.example/mcp
